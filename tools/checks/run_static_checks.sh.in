#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# run_static_checks.sh — Generated helper for static analysis
# =============================================================================
# This script is generated by CMake at configure time.  Do not edit directly.
# =============================================================================

# --- clang-tidy ---
CLANG_TIDY="@CLANG_TIDY_EXE@"
BUILD_DIR="@CMAKE_BINARY_DIR@"
INCLUDE_DIR="@PROJECT_INCLUDE_DIR@"
GTEST_INCLUDE_DIR="@GTEST_INCLUDE_DIR@"

run_clang_tidy() {
    local files=("$@")
    if [[ "${#files[@]}" -eq 0 ]]; then
        echo "No files to check with clang-tidy."
        return 0
    fi
    local status=0
    for f in "${files[@]}"; do
        [[ -f "$f" ]] || continue
        case "$f" in
            dist/*|build*/*|cmake-build-*/*) continue ;;
        esac
        echo "clang-tidy: $f"
        if ! "$CLANG_TIDY" "$f" -p "$BUILD_DIR" \
            2>&1; then
            status=1
        fi
    done
    return $status
}

# --- cppcheck ---
CPPCHECK="@CPPCHECK_EXE@"
INCLUDE_DIR="@PROJECT_INCLUDE_DIR@"

run_cppcheck() {
    local files=("$@")
    if [[ "${#files[@]}" -eq 0 ]]; then
        echo "No files to check with cppcheck."
        return 0
    fi
    local status=0
    for f in "${files[@]}"; do
        [[ -f "$f" ]] || continue
        case "$f" in
            dist/*|build*/*|cmake-build-*/*) continue ;;
        esac
        echo "cppcheck: $f"
        if ! "$CPPCHECK" \
            --enable=warning,performance,portability,style \
            --inline-suppr \
            --std=c++@CMAKE_CXX_STANDARD@ \
            --include="$INCLUDE_DIR" \
            --suppress=unusedFunction \
            --suppress=missingIncludeSystem \
            --suppress=unusedStructMember \
            --suppress=unreadVariable \
            --suppress=noExplicitConstructor \
            --suppress=useStlAlgorithm \
            --suppress=passedByValue \
            --error-exitcode=1 \
            "$f" 2>&1; then
            status=1
        fi
    done
    return $status
}

# --- File list ---
ALL_FILES=(
@PROJECT_CHECK_FILES@
)
